# Wompi configuration — Phase 2 (Wompi-first payments)
# These variables are the ONLY source of truth for Wompi.
# Copy into api/.env (local), .env.staging or .env.production as appropriate.
# If Wompi is enabled and any variable is missing, the API fails to start.

# Wompi environment: sandbox | production
WOMPI_ENV=sandbox

# Keys — from https://comercios.wompi.com/ (sandbox) / https://comercios.wompi.co/ (production)
WOMPI_PUBLIC_KEY=pub_test_xxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxx

# Secrets — Wompi dashboard → Developers → Events/Integrity
WOMPI_EVENTS_SECRET=test_events_xxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxx

# Frontend public key (must match WOMPI_PUBLIC_KEY)
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxx

# Provider switches (Phase 2 policy)
PAYMENTS_WOMPI_ENABLED=true
PAYMENTS_BOLD_ENABLED=false
PAYMENTS_STRIPE_ENABLED=false

# live in production, mock in staging/local
PAYMENTS_MODE=mock

# FX engine — COP per 1 USD (ops-controlled until a live rate source is wired)
FX_COP_USD_RATE=4000
FX_QUOTE_TTL_MINUTES=15

# Legal safety gate — international converted checkout (display USD, charge COP)
# stays blocked until legal signoff exists. See legal-review-pack.md.
FX_INTL_CHECKOUT_ENABLED=false
LEGAL_SIGNOFF_REF=
