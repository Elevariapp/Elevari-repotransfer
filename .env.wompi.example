# Wompi Colombia integration environment template.
# Copy these values into the API runtime environment (api/.env locally or the
# deployment environment file). Never commit actual merchant credentials.
# Use the same host for real testing/production at this stage; the public launch
# domain will be changed only after explicit approval.
NEXT_PUBLIC_SITE_URL=https://eleveri.app
NEXT_PUBLIC_API_URL=https://eleveri.app
PUBLIC_SITE_URL=https://eleveri.app
CORS_ORIGIN=https://eleveri.app

# Use sandbox for tests; set production only when intentionally processing live transactions.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
