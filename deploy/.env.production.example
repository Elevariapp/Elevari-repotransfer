# Elevari — Production environment template
# Copy to .env.production and fill values. NEVER commit .env.production
# Every value here is a placeholder. validate-env.sh rejects any production value that starts
# with change_me, so an unfilled template cannot be deployed by mistake.

# --- Database ---
POSTGRES_USER=elevari
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=elevari

# --- Public URLs (used by nginx, web build, API emails) ---
NEXT_PUBLIC_SITE_URL=https://elevari.live
NEXT_PUBLIC_API_URL=https://elevari.live
PUBLIC_SITE_URL=https://elevari.live

# --- API core ---
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
JWT_SECRET=change_me_jwt_min_32_chars
# Same JWT_SECRET required by the Next.js proxy (web container reads .env.production)
# ⚠️ JWT_SECRET es obligatorio en producción. Genera un valor único de al menos 32 caracteres.
# Nunca uses el valor de desarrollo en producción.
CORS_ORIGIN=https://elevari.live

# --- MinIO ---
MINIO_ACCESS_KEY=elevari_minio_prod
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=elevari-media
MINIO_PUBLIC_URL=https://media.elevari.live/elevari-media
MEDIA_AUTO_APPROVE=false

# --- Payments (live) ---
PAYMENTS_MODE=live
NEXT_PUBLIC_PAYMENTS_MODE=live

# Phase 2 — Wompi is the ONLY active provider (see .env.wompi.example)
PAYMENTS_WOMPI_ENABLED=true
PAYMENTS_BOLD_ENABLED=false
PAYMENTS_STRIPE_ENABLED=false
# Keys from the Wompi dashboard (production): pub_prod_..., prv_prod_..., prod_events_..., prod_integrity_...
WOMPI_PUBLIC_KEY=change_me_wompi_public_key
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=change_me_wompi_public_key
WOMPI_PRIVATE_KEY=change_me_wompi_private_key
WOMPI_EVENTS_SECRET=change_me_wompi_events_secret
WOMPI_INTEGRITY_SECRET=change_me_wompi_integrity_secret

# FX engine + legal gate
FX_COP_USD_RATE=4000
FX_QUOTE_TTL_MINUTES=15
FX_INTL_CHECKOUT_ENABLED=false
LEGAL_SIGNOFF_REF=

# Pricing — platform fee percent (default 15)
PLATFORM_FEE_PERCENT=15


# --- Alegra (Colombia invoicing) ---
ALEGRA_EMAIL=change_me_alegra_account_email
ALEGRA_API_TOKEN=change_me_alegra_api_token

# --- Email (Resend) ---
# Without RESEND_API_KEY no email is sent at all (password reset, booking confirmations, alerts).
# RESEND_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM="Elevari <reserve@elevari.live>"

# --- Marketing ---
META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# --- Google OAuth and Maps ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Mobile app ---
# Optional. The app sends this value as the x-api-key header so sign-in/registration can skip
# Turnstile (a native app cannot render the widget). It ships inside the APK, so it is not a strong secret.
API_CLIENT_KEY=

# --- Cloudflare Turnstile (auth) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_DISABLED=0

# --- Meta Conversions API ---
META_ACCESS_TOKEN=

# --- Web: WhatsApp launcher + Android install banner (build-time, both optional) ---
# Digits only, with country code. Empty = the default Elevari number.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Play Store listing URL. Empty = the install banner offers the web app instead.
NEXT_PUBLIC_ANDROID_APP_URL=
# Set to 1 only once the Google Play listing is public: it adds the "Descarga la app para Android" links
# (install card and /app page). Empty = no Play links, so the site never points at a dead page.
NEXT_PUBLIC_PLAY_STORE_LIVE=

# --- WhatsApp Business bot (elevari-bot, Meta Cloud API) ---
# Webhook URL to register in Meta: https://<dominio>/webhook/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# App Secret of the Meta app (App settings → Basic). The bot verifies every webhook signature with it
# and answers 503 in production if it is missing.
WHATSAPP_APP_SECRET=

# --- Optional monitoring ---
SENTRY_DSN=
