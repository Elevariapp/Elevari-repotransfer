# Elevari — Production environment template
# Copy to .env.production and fill values. NEVER commit .env.production

# --- Database ---
POSTGRES_USER=elevari
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=elevari

# --- Public URLs (used by nginx, web build, API emails) ---
NEXT_PUBLIC_SITE_URL=https://elevari.live
NEXT_PUBLIC_API_URL=https://elevari.live
PUBLIC_SITE_URL=https://elevari.live

# --- API core ---
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
JWT_SECRET=change_me_jwt_secret_min_32_chars
# Same JWT_SECRET required by the web container (proxy.ts verifies sessions). Min 32 chars or the API/web refuse to start.
CORS_ORIGIN=https://elevari.live,https://www.elevari.live
DISABLE_DEMO_ACCOUNTS=true

# --- Antibots (Cloudflare Turnstile, widget "Elevari Web") ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAGL6Nkc1KmMspy5d
TURNSTILE_SECRET_KEY=
TURNSTILE_DISABLED=false
NEXT_PUBLIC_TURNSTILE_DISABLED=false

# --- MinIO ---
MINIO_ACCESS_KEY=elevari_minio_prod
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=elevari-media
MINIO_PUBLIC_URL=https://media.elevari.live/elevari-media
MEDIA_AUTO_APPROVE=false

# --- Payments (live) ---
PAYMENTS_MODE=live
NEXT_PUBLIC_PAYMENTS_MODE=live
# Internal smoke tests only (never with public traffic): PAYMENTS_MODE=mock + ALLOW_MOCK_PAYMENTS=true
# ALLOW_MOCK_PAYMENTS=
# Phase 2 — Wompi is the ONLY active provider (see .env.wompi.example)
PAYMENTS_WOMPI_ENABLED=true
PAYMENTS_BOLD_ENABLED=false
PAYMENTS_STRIPE_ENABLED=false
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# FX engine + legal gate
FX_COP_USD_RATE=4000
FX_QUOTE_TTL_MINUTES=15
FX_INTL_CHECKOUT_ENABLED=false
LEGAL_SIGNOFF_REF=

# Pricing — platform fee percent (default 15)
PLATFORM_FEE_PERCENT=15

# Legacy providers (kept for rollback; disabled above)
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_COP_USD_RATE=4000

# --- Alegra (Colombia invoicing) ---
ALEGRA_EMAIL=
ALEGRA_API_TOKEN=
# Leave empty until DIAN electronic invoicing is enabled in Alegra; then set to "open" (invoices are created in Alegra).
ALEGRA_INVOICE_STATUS=
# Optional: bank/cash account id in Alegra where the Wompi payment is recorded on each invoice.
ALEGRA_BANK_ACCOUNT_ID=

# --- Marketing ---
RESEND_API_KEY=
RESEND_FROM="Elevari <reserve@elevari.live>"
META_PIXEL_ID=
META_ACCESS_TOKEN=
NEXT_PUBLIC_GTM_ID=GTM-PXVGFFMK
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-W4QC0NYBVJ

# —— Android app link verification (served at /.well-known/assetlinks.json) ——
# Comma-separated SHA-256 fingerprints: Play App Signing key + upload key
ANDROID_SHA256_CERT_FINGERPRINTS=
ANDROID_PACKAGE_NAME=elevari.androidapp
NEXT_PUBLIC_META_PIXEL_ID=

# --- Optional monitoring ---
SENTRY_DSN=
