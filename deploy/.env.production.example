# Waná — Production environment template
# Copy to .env.production and fill values. NEVER commit .env.production

# --- Database ---
POSTGRES_USER=wana
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=wana

# --- Public URLs (used by nginx, web build, API emails) ---
NEXT_PUBLIC_SITE_URL=https://wana.co
NEXT_PUBLIC_API_URL=https://wana.co
PUBLIC_SITE_URL=https://wana.co

# --- API core ---
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
JWT_SECRET=change_me_jwt_secret_min_32_chars
# Same JWT_SECRET required by Next.js middleware (web container reads .env.production)
CORS_ORIGIN=https://wana.co

# --- MinIO ---
MINIO_ACCESS_KEY=wana_minio_prod
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=wana-media
MINIO_PUBLIC_URL=https://media.wana.co/wana-media
MEDIA_AUTO_APPROVE=false

# --- Payments (live) ---
PAYMENTS_MODE=live

# Phase 2 — Wompi is the ONLY active provider (see .env.wompi.example)
PAYMENTS_WOMPI_ENABLED=true
PAYMENTS_BOLD_ENABLED=false
PAYMENTS_STRIPE_ENABLED=false
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# FX engine + legal gate
FX_COP_USD_RATE=4000
FX_QUOTE_TTL_MINUTES=15
FX_INTL_CHECKOUT_ENABLED=false
LEGAL_SIGNOFF_REF=

# Pricing — platform fee percent (default 15)
PLATFORM_FEE_PERCENT=15

# Legacy providers (kept for rollback; disabled above)
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_COP_USD_RATE=4000

# --- Alegra (Colombia invoicing) ---
ALEGRA_EMAIL=
ALEGRA_API_TOKEN=

# --- Marketing ---
RESEND_API_KEY=
RESEND_FROM="Waná <reservas@wana.co>"
META_PIXEL_ID=
META_ACCESS_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Optional monitoring ---
SENTRY_DSN=
