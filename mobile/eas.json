{
  "cli": {
    "version": ">= 58.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "channel": "production",
      "distribution": "store"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "com.elevari.app",
        "ascAppId": "0000000000",
        "appleTeamId": "TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/google-service-account.json",
        "track": "internal"
      }
    }
  }
}