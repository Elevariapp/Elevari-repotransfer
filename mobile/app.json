{
  "expo": {
    "name": "Elevari",
    "slug": "elevari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C2410C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "elevari.iosapp",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Elevari necesita enviar notificaciones push para confirmaciones de reserva y actualizaciones de anfitrión.",
        "NSLocationWhenInUseUsageDescription": "Elevari usa tu ubicación para mostrar propiedades cercanas.",
        "NSCameraUsageDescription": "Elevari necesita acceso a la cámara para subir fotos de tu propiedad.",
        "NSPhotoLibraryUsageDescription": "Elevari necesita acceso a tu galería para subir fotos de tu propiedad."
      },
      "associatedDomains": [
        "applinks:app.elevari.live"
      ]
    },
    "android": {
      "package": "elevari.androidapp",
      "adaptiveIcon": {
        "backgroundColor": "#C2410C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.elevari.live",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C2410C",
          "permissions": [
            "NOTIFICATIONS"
          ]
        }
      ],
      "expo-secure-store",
      "expo-image-picker",
      "expo-file-system",
      [
        "expo-build-properties",
        {
          "android": {
            "gradleVersion": "8.1.1",
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          }
        }
      ]
    ],
    "scheme": "elevari",
    "extra": {
      "API_BASE_URL": "https://elevari.live/api/v1",
      "PRIVACY_URL": "https://www.elevari.live/legal/privacy",
      "TERMS_URL": "https://www.elevari.live/legal/terms",
      "REFUND_URL": "https://www.elevari.live/legal/refund",
      "ACCOUNT_DELETION_URL": "https://www.elevari.live/legal/account-deletion",
      "CONTACT_URL": "https://www.elevari.live/legal/contact",
      "COMPLIANCE": {
        "dataProtectionLaw": "Ley 1581 de 2012 (Colombia)",
        "platformFeePercent": 15,
        "currency": "COP",
        "taxEngine": false
      }
    }
  }
}
