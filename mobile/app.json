{
  "expo": {
    "name": "Elevari",
    "slug": "elevari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "elevari.androidapp",
      "adaptiveIcon": {
        "backgroundColor": "#1E4835",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "elevari.live",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "./plugins/withAndroidReleaseBuild",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E4835"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F6B4F",
          "permissions": [
            "NOTIFICATIONS"
          ]
        }
      ],
      "expo-secure-store",
      "expo-image-picker",
      "expo-file-system"
    ],
    "scheme": "elevari",
    "extra": {
      "API_BASE_URL": "https://elevari.live",
      "PRIVACY_URL": "https://elevari.live/legal/privacy",
      "TERMS_URL": "https://elevari.live/legal/terms",
      "REFUND_URL": "https://elevari.live/legal/refund",
      "ACCOUNT_DELETION_URL": "https://elevari.live/legal/account-deletion",
      "CONTACT_URL": "https://elevari.live/legal/contact",
      "COMPLIANCE": {
        "dataProtectionLaw": "Ley 1581 de 2012 (Colombia)",
        "platformFeePercent": 15,
        "currency": "COP",
        "taxEngine": false
      }
    }
  }
}
