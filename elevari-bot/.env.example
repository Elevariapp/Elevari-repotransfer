# Servidor
PORT=3001
NODE_ENV=development

# Ollama (Opción A - self-hosted)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Base de datos (PostgreSQL existente de Elevari)
DATABASE_URL=postgresql://postgres:password@localhost:5432/elevari

# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=tu_token_de_acceso_meta
WHATSAPP_PHONE_NUMBER_ID=tu_numero_telefono_id
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion

# Wompi (pagos existentes)
WOMPI_SECRET_KEY=tu_llave_privada_wompi
WOMPI_INTEGRATION_KEY=tu_llave_integracion_wompi

# JWT / Auth (reusar de Elevari)
JWT_SECRET=tu_jwt_secret