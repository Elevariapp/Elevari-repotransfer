# Meta Cloud API Credentials for WhatsApp Business
# Copy this file to .env and fill in your actual values

# ID de la aplicación Meta
META_APP_ID=your_meta_app_id

# Token de acceso del sistema (System User Access Token) de Meta Cloud API
WHATSAPP_TOKEN=your_whatsapp_token

# ID del número de teléfono de WhatsApp Business (Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ID de la cuenta de mensajes de WhatsApp Business (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# Token de verificación del webhook (define un valor secreto)
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Configuración del servidor (opcional)
PORT=3001
HOST=0.0.0.0