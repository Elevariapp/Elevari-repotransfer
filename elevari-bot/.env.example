# Copy to .env for local dev (`npm run dev` loads it; .env is git-ignored).
# In production these come from the root .env.production: never commit real values.

# Meta app secret (App settings > Basic). Verifies X-Hub-Signature-256 on every webhook POST.
# REQUIRED in production: without it the bot refuses all webhook POSTs with 503.
WHATSAPP_APP_SECRET=

# Token you choose; paste the same value in Meta > WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=

# Replies are disabled until both of these are set
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Optional
PUBLIC_SITE_URL=https://elevari.live
GRAPH_API_VERSION=v21.0

PORT=3001
HOST=0.0.0.0
