# ============================================================================
# ELEVARI — Environment template (official architecture)
# ============================================================================
# Core: AWS EC2 · PostgreSQL · S3-compatible storage · Cloudflare · Wompi
# Extensions: Fly.io · Hugging Face
#
# Out of scope: Vercel · Supabase · Firebase · Netlify
# Payments: see .env.wompi.example (Wompi is the only provider)
# ============================================================================

# —— Runtime ——
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_SITE_URL=https://elevari.live
NEXT_PUBLIC_SITE_URL=https://elevari.live
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,https://elevari.live,https://www.elevari.live

# —— Database (PostgreSQL) ——
DATABASE_URL=postgresql://elevari:elevari_dev_password@localhost:5432/elevari?schema=public

# —— Redis (rate limit / queues) ——
REDIS_URL=redis://localhost:6379

# —— Auth ——
JWT_SECRET=change_me_in_production
DISABLE_DEMO_ACCOUNTS=false

# —— Object storage (S3-compatible: MinIO local, S3/R2 in production) ——
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=elevari_minio
MINIO_SECRET_KEY=elevari_minio_password
MINIO_BUCKET=elevari-media
# Private bucket for host identity documents (never publicly readable).
MINIO_PRIVATE_BUCKET=elevari-private
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000/elevari-media
MEDIA_AUTO_APPROVE=true
# Deterministic rules can publish photos/videos without an AI provider. Set to false to force
# every upload through the human queue (identity documents always need Vision or a person).
MEDIA_RULES_AUTO_APPROVE=true

# —— AI moderation / verification (Google Cloud Vision) ——
# API key with the Cloud Vision API enabled. Enables instant decisions for host media and the
# government-ID + selfie check. Without it, everything is queued with a 1-hour human deadline.
AI_MODERATION_VISION_KEY=
AI_MODERATION_MODEL=elevari-moderation-v1

# —— Firebase (FCM HTTP v1 push for the bare Android APK/AAB) ——
# Base64 of the service-account JSON. When set, native device tokens receive push directly.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# —— Pricing ——
PLATFORM_FEE_PERCENT=15

# —— Jobs ——
BOOKING_PENDING_TTL_MINUTES=30
BOOKING_EXPIRY_JOB_INTERVAL_MS=60000
CHECKIN_REMINDER_JOB_INTERVAL_MS=3600000
ICAL_SYNC_ENABLED=false
ICAL_SYNC_JOB_INTERVAL_MS=900000

# —— Transactional email (Resend) ——
RESEND_API_KEY=
RESEND_FROM="Elevari <reserve@elevari.live>"

# —— Invoicing (Alegra, Colombia) ——
ALEGRA_EMAIL=
ALEGRA_API_TOKEN=

# —— Marketing / analytics ——
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=

# —— Bot protection (Cloudflare Turnstile) ——
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_DISABLED=true
TURNSTILE_DISABLED=true

# —— Google sign-in ——
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# —— Google Maps (Property detail pages) ——
# Obtain from Google Cloud Console → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# —— Observability (PPI-4) ——
# Same-origin ingestion endpoint: POST /api/observability
# Forward target: Sentry relay, log drain, Slack webhook, etc. Optional.
OBSERVABILITY_WEBHOOK_URL=
OBSERVABILITY_WEBHOOK_TOKEN=

# —— Backups (deploy/scripts) ——
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_BYTES=1024
