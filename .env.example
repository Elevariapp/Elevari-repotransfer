# ============================================================================
# ELEVARI — Environment template (official architecture)
# ============================================================================
# Core: AWS EC2 · PostgreSQL · S3-compatible storage · Cloudflare · Wompi
# Extensions: Fly.io · Hugging Face
#
# Out of scope: Vercel · Supabase · Firebase · Netlify
# Payments: see .env.wompi.example (Wompi is the only provider)
# ============================================================================

# —— Runtime ——
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_SITE_URL=https://eleveri.app
NEXT_PUBLIC_SITE_URL=https://eleveri.app
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,https://eleveri.app,https://www.eleveri.app

# —— Database (PostgreSQL) ——
DATABASE_URL=postgresql://wana:wana_dev_password@localhost:5432/wana?schema=public

# —— Redis (rate limit / queues) ——
REDIS_URL=redis://localhost:6379

# —— Auth ——
JWT_SECRET=change_me_in_production
DISABLE_DEMO_ACCOUNTS=false

# —— Object storage (S3-compatible: MinIO local, S3/R2 in production) ——
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=wana_minio
MINIO_SECRET_KEY=wana_minio_password
MINIO_BUCKET=wana-media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000/wana-media
MEDIA_AUTO_APPROVE=true

# —— Pricing ——
PLATFORM_FEE_PERCENT=15

# —— Jobs ——
BOOKING_PENDING_TTL_MINUTES=30
BOOKING_EXPIRY_JOB_INTERVAL_MS=60000
CHECKIN_REMINDER_JOB_INTERVAL_MS=3600000
ICAL_SYNC_ENABLED=false
ICAL_SYNC_JOB_INTERVAL_MS=900000

# —— Transactional email (Resend) ——
RESEND_API_KEY=
RESEND_FROM=Eleveri <reservas@eleveri.app>

# —— Invoicing (Alegra, Colombia) ——
ALEGRA_EMAIL=
ALEGRA_API_TOKEN=

# —— Marketing / analytics ——
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=

# —— Bot protection (Cloudflare Turnstile) ——
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_DISABLED=true
TURNSTILE_DISABLED=true

# —— Google sign-in ——
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# —— Backups (deploy/scripts) ——
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_BYTES=1024
