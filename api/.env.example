# Waná API — local development
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://wana:wana_dev_password@localhost:5432/wana?schema=public
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=wana_minio
MINIO_SECRET_KEY=wana_minio_password
MINIO_BUCKET=wana-media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000/wana-media
MEDIA_AUTO_APPROVE=true

JWT_SECRET=wana_dev_jwt_secret_change_in_production
CORS_ORIGIN=http://localhost:3000

BOOKING_PENDING_TTL_MINUTES=30
BOOKING_EXPIRY_JOB_INTERVAL_MS=300000
CHECKIN_REMINDER_JOB_INTERVAL_MS=21600000

PAYMENTS_MODE=mock

# Wompi config source of truth. Required when PAYMENTS_MODE=live.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# Bold fallback and Stripe USD
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=Waná <reservas@wana.co>
META_PIXEL_ID=
META_ACCESS_TOKEN=
ALEGRA_EMAIL=
ALEGRA_API_TOKEN=
